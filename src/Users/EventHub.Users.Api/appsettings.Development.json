{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "UsersDatabase": "Host=localhost;Port=5432;Database=eventhub_users;Username=postgres;Password=postgres"
  },
  "Authentication": {
    "Jwt": {
      "ValidateIssuer": true,
