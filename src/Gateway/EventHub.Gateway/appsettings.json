{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "users-api": {
        "ClusterId": "users",
        "Match": {
          "Path": "/api/{version}/auth/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/{version}/auth/{**remainder}" }
        ]
      },
      "events-api": {
        "ClusterId": "events",
        "Match": {
          "Path": "/api/{version}/events/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/{version}/events/{**remainder}" }
        ]
      },
      "bookings-api": {
        "ClusterId": "bookings",
        "Match": {
          "Path": "/api/{version}/bookings/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/{version}/bookings/{**remainder}" }
        ]
      },
      "docs-users": {
        "ClusterId": "users",
        "Match": {
          "Path": "/docs/users/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/docs/users" }
        ]
      },
      "docs-events": {
        "ClusterId": "events",
        "Match": {
          "Path": "/docs/events/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/docs/events" }
        ]
      },
      "docs-bookings": {
        "ClusterId": "bookings",
        "Match": {
          "Path": "/docs/bookings/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/docs/bookings" }
        ]
      }
    },
    "Clusters": {
      "users": {
        "Destinations": {
          "users": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "events": {
        "Destinations": {
          "events": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "bookings": {
        "Destinations": {
          "bookings": {
            "Address": "http://localhost:5103"
          }
        }
      }
    }
  }
}