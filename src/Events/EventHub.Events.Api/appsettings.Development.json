{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "EventsDatabase": "Host=localhost;Port=5432;Database=eventhub_events;Username=postgres;Password=postgres"
  },
  "Authentication": {
    "Jwt": {
      "ValidateIssuer": true,
      "ValidateAudience": true,
      "ValidateLifetime": true,
      "ValidateIssuerSigningKey": true,
      "Audience": "eventhub-api",
      "Issuer": "https://eventhub.dev.com",
      "Secret": "default-long-secret-key-for-local-development",
      "ClockSkew": "00:05:00"
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "eventhub-events"
  }
}