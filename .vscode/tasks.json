      "type": "shell",
      "command": "dotnet",
      "args": ["build", "src/Bookings/EventHub.Bookings.Api/EventHub.Bookings.Api.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-gateway",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "src/Gateway/EventHub.Gateway/EventHub.Gateway.csproj"],
