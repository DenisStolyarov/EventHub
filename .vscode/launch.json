{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Gateway",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-gateway",
      "program": "${workspaceFolder}/src/Gateway/EventHub.Gateway/bin/Debug/net10.0/EventHub.Gateway.dll",
      "cwd": "${workspaceFolder}/src/Gateway/EventHub.Gateway",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Users API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-users",
      "program": "${workspaceFolder}/src/Users/EventHub.Users.Api/bin/Debug/net10.0/EventHub.Users.Api.dll",
      "cwd": "${workspaceFolder}/src/Users/EventHub.Users.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5101"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Events API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-events",
      "program": "${workspaceFolder}/src/Events/EventHub.Events.Api/bin/Debug/net10.0/EventHub.Events.Api.dll",
      "cwd": "${workspaceFolder}/src/Events/EventHub.Events.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5102"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Bookings API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-bookings",
      "program": "${workspaceFolder}/src/Bookings/EventHub.Bookings.Api/bin/Debug/net10.0/EventHub.Bookings.Api.dll",
      "cwd": "${workspaceFolder}/src/Bookings/EventHub.Bookings.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5103"
      },
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "All Services",
      "configurations": ["Gateway", "Users API", "Events API", "Bookings API"],
      "stopAll": true
    }
  ]
}